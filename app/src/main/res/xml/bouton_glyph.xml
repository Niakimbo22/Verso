<?xml version="1.0" encoding="utf-8"?>
<!--
    Service d'accessibilité « Verso · Glyph et apps » :
    - quand on touche ⏻ dans Verso, il ouvre le menu déroulant, appuie sur la tuile Glyph et le referme ;
    - il note quelle app est ouverte (changements de fenêtre seulement, jamais le contenu) pour la
      condition « App ouverte » des règles automatiques.
    Il n'envoie rien hors du téléphone.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="false"
    android:description="@string/bouton_glyph_description"
    android:notificationTimeout="100"
    android:summary="@string/bouton_glyph_resume" />
