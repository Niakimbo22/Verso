<?xml version="1.0" encoding="utf-8"?>
<!-- Boutons ‹ ⏻ › des widgets Verso : des icônes (la police du lanceur n'a pas le caractère « ⏻ »). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rangee"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/btn_prec"
        android:layout_width="44dp"
        android:layout_height="36dp"
        android:contentDescription="@string/widget_precedent"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_w_precedent" />

    <ImageView
        android:id="@+id/btn_onoff"
        android:layout_width="44dp"
        android:layout_height="36dp"
        android:contentDescription="@string/raccourci_basculer"
        android:paddingHorizontal="11dp"
        android:paddingVertical="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_w_marche" />

    <ImageView
        android:id="@+id/btn_suiv"
        android:layout_width="44dp"
        android:layout_height="36dp"
        android:contentDescription="@string/widget_suivant"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_w_suivant" />
</LinearLayout>
