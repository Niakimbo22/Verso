<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- SDK Glyph : accès au service de la Glyph Matrix -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />

    <!-- Expérience du Diagnostic : garder les animations éveillées écran éteint -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Widget : remettre l'horloge à l'heure à la minute pile (sans réveiller le téléphone) -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Prévenir quand le système arrête le Glyph Toy -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Relancer le modèle après un redémarrage du téléphone -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+ : rend visible le service système Glyph pour bindService -->
    <queries>
        <package android:name="com.nothing.thirdparty" />
    </queries>

    <application
        android:name=".VersoApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Verso">

        <!-- Clé SDK Nothing : "test" suffit pour un usage perso (une vraie clé ne sert qu'à publier) -->
        <meta-data
            android:name="NothingKey"
            android:value="test" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <!-- Vérifie 2 min après un arrêt du Glyph Toy s'il a été relancé, sinon notifie -->
        <receiver
            android:name=".toy.SurveillanceToy"
            android:exported="false" />

        <receiver
            android:name=".toy.DemarrageReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            Glyph Toy « Verso » : à choisir dans
            Réglages › Glyph Interface › Flip to Glyph › Always-on Glyph Toy.
            Un Toy passe devant l'affichage des apps : le modèle reste affiché app fermée.
        -->
        <service
            android:name=".toy.VersoToyService"
            android:enabled="true"
            android:exported="true"
            android:permission="com.nothing.ketchum.permission.BIND_GLYPH_TOY">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>

            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_nom" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/toy_preview" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/toy_resume" />
            <!-- Le Phone (4a) Pro n'accepte que les Toys « Always-on » -->
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1" />
        </service>

        <receiver
            android:name=".widget.WidgetCarre"
            android:exported="false"
            android:label="@string/widget_carre">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_carre" />
        </receiver>

        <receiver
            android:name=".widget.WidgetRond"
            android:exported="false"
            android:label="@string/widget_rond">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_rond" />
        </receiver>

        <receiver
            android:name=".widget.WidgetBarre"
            android:exported="false"
            android:label="@string/widget_barre">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_barre" />
        </receiver>

        <receiver
            android:name=".widget.WidgetMini"
            android:exported="false"
            android:label="@string/widget_mini">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_mini" />
        </receiver>

        <receiver
            android:name=".widget.WidgetActions"
            android:exported="false" />

        <activity
            android:name=".widget.ConfigWidgetActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.ChoixRapideActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="fr.niakimbo.verso.choix"
            android:theme="@style/Theme.Verso.Fenetre" />
    </application>
</manifest>
